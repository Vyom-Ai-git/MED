# Vyoma LabOS Environment Variables

# Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000

# Database Connection (standard local PostgreSQL)
DATABASE_URL=postgresql://localhost/labos_db

# Security & Authentication
JWT_SECRET=supersecretchangeinproduction1234567890abc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_PATH=storage/reports

# n8n Integration Configuration
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_INTEGRATION_KEY=
INTEGRATION_TIMEOUT_SECONDS=15
INTEGRATION_MAX_RETRIES=3
