# Vyoma LabOS Environment Variables

# Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000

# Database Connection (standard local PostgreSQL)
DATABASE_URL=postgresql://localhost/labos_db

# Security & Authentication
JWT_SECRET=supersecretchangeinproduction1234567890abc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_PATH=storage/reports

# Native Flask WhatsApp workflow
FLASK_WORKFLOW_URL=http://localhost:5000/api/v1/webhooks/labos
FLASK_WORKFLOW_SECRET=
LABOS_API_KEY=
INTEGRATION_TIMEOUT_SECONDS=15
INTEGRATION_MAX_RETRIES=3
